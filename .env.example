# Copy to .env and fill in. Docker Compose reads .env automatically.
POSTGRES_DB=shelf
POSTGRES_USER=shelf
POSTGRES_PASSWORD=change-me

# Your Firebase UID, and the handle of your shelf (e.g. anaelle).
SHELF_ADMIN_UID=change-me
SHELF_ADMIN_HANDLE=change-me

# https://rebrickable.com/users/<you>/settings/#api
REBRICKABLE_API_KEY=change-me
